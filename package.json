{
  "name": "minions",
  "version": "0.1.0",
  "description": "Containerized Claude Code agent team for software projects",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antoniibelyshev/minions.git"
  },
  "homepage": "https://github.com/antoniibelyshev/minions#readme",
  "type": "module",
  "bin": {
    "minions": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist",
    "templates",
    "docker",
    "schema",
    "install.sh",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs",
    "prepare": "node scripts/prepare.mjs",
    "schema": "node esbuild.config.mjs --schema-only",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack": "npm run build && npm pack",
    "e2e": "bash scripts/e2e.sh",
    "verify:git-install": "bash scripts/verify-git-install.sh"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.20.5",
    "commander": "^15.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  }
}
