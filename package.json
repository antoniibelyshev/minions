{
  "name": "minions",
  "version": "0.1.0",
  "description": "Containerized Claude Code agent team for software projects",
  "type": "module",
  "bin": {
    "minions": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist",
    "templates",
    "docker",
    "schema",
    "install.sh",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs",
    "schema": "node esbuild.config.mjs --schema-only",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack": "npm run build && npm pack"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.20.5",
    "commander": "^15.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  }
}
